{
  "name": "@metamask/eth-sig-util",
  "version": "9.0.0",
  "description": "A few useful functions for signing ethereum data",
  "keywords": [
    "Ethereum",
    "MetaMask"
  ],
  "homepage": "https://github.com/MetaMask/core/tree/main/packages/eth-sig-util#readme",
  "bugs": {
    "url": "https://github.com/MetaMask/core/issues"
  },
  "license": "ISC",
  "author": "Dan Finlay",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/core.git"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./encryption": {
      "types": "./dist/encryption.d.ts",
      "default": "./dist/encryption.js"
    },
    "./personal-sign": {
      "types": "./dist/personal-sign.d.ts",
      "default": "./dist/personal-sign.js"
    },
    "./sign-typed-data": {
      "types": "./dist/sign-typed-data.d.ts",
      "default": "./dist/sign-typed-data.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "allow-scripts": "yarn workspace @metamask/core-monorepo run allow-scripts",
    "build": "tsc --project tsconfig.build.json",
    "build:all": "tsc --build tsconfig.build.json --verbose",
    "build:clean": "yarn build:only-clean && yarn build",
    "build:docs": "typedoc",
    "build:only-clean": "rimraf './dist' './tsconfig.build.tsbuildinfo'",
    "changelog:update": "../../scripts/update-changelog.sh @metamask/eth-sig-util",
    "changelog:validate": "../../scripts/validate-changelog.sh",
    "lint:tsconfigs": "node --import ../../scripts/resolver/register.ts ../../scripts/lint-tsconfigs/lint-tsconfigs.ts",
    "lint:tsconfigs:fix": "node --import ../../scripts/resolver/register.ts ../../scripts/lint-tsconfigs/lint-tsconfigs.ts --fix",
    "since-latest-release": "../../scripts/since-latest-release.sh",
    "test": "vitest",
    "test:clean": "vitest --clearCache",
    "test:coverage": "vitest --coverage",
    "test:verbose": "vitest --reporter=verbose",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@ethereumjs/rlp": "^4.0.1",
    "@ethereumjs/util": "^8.1.0",
    "@metamask/abi-utils": "^3.0.0",
    "@metamask/cryptography": "^1.1.2",
    "@metamask/utils": "^12.0.1",
    "@noble/ciphers": "^1.3.0",
    "ethereum-cryptography": "^3.2.0"
  },
  "devDependencies": {
    "@metamask/auto-changelog": "^7.1.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "ajv": "^8.11.0",
    "rimraf": "^6.1.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-missing-exports": "^4.1.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "^22.14.0 || ^24 || ^26"
  }
}
