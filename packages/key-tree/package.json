{
  "name": "@metamask/key-tree",
  "version": "10.1.1",
  "description": "An interface over BIP-32 and BIP-39 key derivation paths",
  "keywords": [
    "Ethereum",
    "MetaMask"
  ],
  "homepage": "https://github.com/MetaMask/core/tree/main/packages/key-tree#readme",
  "bugs": {
    "url": "https://github.com/MetaMask/core/issues"
  },
  "license": "MIT",
  "author": "kumavis",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/core.git"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "allow-scripts": "yarn workspace @metamask/core-monorepo run allow-scripts",
    "build": "tsc --project tsconfig.build.json",
    "build:all": "tsc --build tsconfig.build.json --verbose",
    "build:clean": "yarn build:only-clean && yarn build",
    "build:docs": "typedoc",
    "build:only-clean": "rimraf './dist' './tsconfig.build.tsbuildinfo'",
    "changelog:update": "../../scripts/update-changelog.sh @metamask/key-tree",
    "changelog:validate": "../../scripts/validate-changelog.sh",
    "generate-vectors": "node --import ../../scripts/resolver/register.ts scripts/generate-vectors.ts > tests/vectors/derivation.json",
    "lint:tsconfigs": "node --import ../../scripts/resolver/register.ts ../../scripts/lint-tsconfigs/lint-tsconfigs.ts",
    "lint:tsconfigs:fix": "node --import ../../scripts/resolver/register.ts ../../scripts/lint-tsconfigs/lint-tsconfigs.ts --fix",
    "since-latest-release": "../../scripts/since-latest-release.sh",
    "test": "vitest",
    "test:clean": "vitest --clearCache",
    "test:coverage": "vitest --coverage",
    "test:verbose": "vitest --reporter=verbose",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@metamask/byte-utils": "^0.1.0",
    "@metamask/cryptography": "^1.1.2",
    "@metamask/scure-bip39": "^2.1.1",
    "@metamask/type-utils": "^0.1.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^1.2.6"
  },
  "devDependencies": {
    "@metamask/auto-changelog": "^7.1.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "rimraf": "^6.1.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-missing-exports": "^4.1.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "^22.14.0 || ^24 || ^26"
  }
}
