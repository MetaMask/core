{
  "name": "@metamask/bridge-controller",
  "version": "83.0.0",
  "description": "Manages bridge-related quote fetching functionality for MetaMask",
  "keywords": [
    "Ethereum",
    "MetaMask"
  ],
  "homepage": "https://github.com/MetaMask/core/tree/main/packages/bridge-controller#readme",
  "bugs": {
    "url": "https://github.com/MetaMask/core/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/core.git"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "build:all": "tsc --build tsconfig.build.json --verbose",
    "build:clean": "yarn build:only-clean && yarn build",
    "build:docs": "typedoc",
    "build:only-clean": "rimraf './dist' './tsconfig.build.tsbuildinfo'",
    "changelog:update": "../../scripts/update-changelog.sh @metamask/bridge-controller",
    "changelog:validate": "../../scripts/validate-changelog.sh @metamask/bridge-controller",
    "lint:tsconfigs": "node --import ../../scripts/resolver/register.ts ../../scripts/lint-tsconfigs/lint-tsconfigs.ts",
    "lint:tsconfigs:fix": "node --import ../../scripts/resolver/register.ts ../../scripts/lint-tsconfigs/lint-tsconfigs.ts --fix",
    "messenger-action-types:check": "node --import ../../scripts/resolver/register.ts ../../packages/messenger-cli/src/cli.ts --formatter oxfmt --esm --check",
    "messenger-action-types:generate": "node --import ../../scripts/resolver/register.ts ../../packages/messenger-cli/src/cli.ts --formatter oxfmt --esm --generate",
    "since-latest-release": "../../scripts/since-latest-release.sh",
    "test": "vitest",
    "test:clean": "vitest --clearCache",
    "test:verbose": "vitest --reporter=verbose",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@ethersproject/address": "^5.8.0",
    "@ethersproject/bignumber": "^5.8.0",
    "@ethersproject/constants": "^5.8.0",
    "@ethersproject/contracts": "^5.7.0",
    "@ethersproject/providers": "^5.8.0",
    "@metamask/accounts-controller": "^40.1.0",
    "@metamask/assets-controller": "^19.1.0",
    "@metamask/assets-controllers": "^112.1.3",
    "@metamask/base-controller": "^10.1.0",
    "@metamask/controller-utils": "^13.0.0",
    "@metamask/gas-fee-controller": "^27.0.0",
    "@metamask/keyring-api": "^24.3.0",
    "@metamask/messenger": "^3.0.0",
    "@metamask/metamask-eth-abis": "^3.1.1",
    "@metamask/multichain-network-controller": "^4.0.0",
    "@metamask/network-controller": "^37.1.1",
    "@metamask/polling-controller": "^17.0.0",
    "@metamask/profile-sync-controller": "^35.0.0",
    "@metamask/remote-feature-flag-controller": "^7.0.0",
    "@metamask/snaps-controllers": "^19.0.1",
    "@metamask/transaction-controller": "^72.2.1",
    "@metamask/utils": "^12.0.0",
    "bignumber.js": "^9.1.2",
    "reselect": "^5.3.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@metamask/auto-changelog": "^6.2.1",
    "@metamask/eth-json-rpc-provider": "^7.0.0",
    "@metamask/superstruct": "^3.4.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "lodash-es": "^4.18.1",
    "nock": "^13.5.6",
    "rimraf": "^6.1.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-missing-exports": "^4.1.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.14.0 || ^24 || ^26"
  }
}
