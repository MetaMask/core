{
  "extends": "../../tsconfig.packages.json",
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "noErrorTruncation": true,
    "noUncheckedIndexedAccess": true,
    // Web3 declarations conflict with exactOptionalPropertyTypes.
    "skipLibCheck": true
  },
  "include": ["../../types", "./src"],
  "references": [
    {
      "path": "../type-utils"
    },
    {
      "path": "../error-utils"
    },
    {
      "path": "../node-utils"
    }
  ]
}
