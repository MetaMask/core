{
  "name": "@metamask/platform-api-docs",
  "version": "0.2.1",
  "description": "Produces documentation for the platform API, the set of actions and events available in the clients through the message bus",
  "keywords": [
    "Ethereum",
    "MetaMask"
  ],
  "homepage": "https://github.com/MetaMask/core/tree/main/packages/platform-api-docs#readme",
  "bugs": {
    "url": "https://github.com/MetaMask/core/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/core.git"
  },
  "bin": "./dist/cli.js",
  "files": [
    "dist/",
    "site/"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "audit-script": "node ../../scripts/audit-script.ts",
    "build": "tsc --project tsconfig.build.json",
    "build:all": "tsc --build tsconfig.build.json --verbose",
    "build:clean": "yarn build:only-clean && yarn build",
    "build:only-clean": "rimraf './dist' './tsconfig.build.tsbuildinfo'",
    "changelog:update": "../../scripts/update-changelog.sh @metamask/platform-api-docs",
    "changelog:validate": "../../scripts/validate-changelog.sh @metamask/platform-api-docs",
    "cli": "node --import ../../scripts/resolver/register.ts src/cli.ts",
    "lint:tsconfigs": "node --import ../../scripts/resolver/register.ts ../../scripts/lint-tsconfigs/lint-tsconfigs.ts",
    "lint:tsconfigs:fix": "node --import ../../scripts/resolver/register.ts ../../scripts/lint-tsconfigs/lint-tsconfigs.ts --fix",
    "since-latest-release": "../../scripts/since-latest-release.sh",
    "test": "vitest",
    "test:clean": "vitest --clearCache",
    "test:verbose": "vitest --reporter=verbose",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/plugin-content-docs": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-common": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@mdx-js/react": "^3.1.1",
    "@metamask/node-utils": "^0.0.0",
    "execa": "^10.0.1",
    "npm-which": "^3.0.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-morph": "^28.0.0",
    "yargs": "^17.7.3"
  },
  "devDependencies": {
    "@metamask/auto-changelog": "^6.2.1",
    "@types/node": "^22.13.14",
    "@types/npm-which": "^3",
    "@types/react": "^19.0.0",
    "@types/yargs": "^17.0.35",
    "@typescript/native": "npm:typescript@^7.0.2",
    "rimraf": "^6.1.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.14.0 || ^24 || ^26"
  },
  "scriptsConfig": {
    "#default": "lavamoat/scripts.strict.json",
    "audit-script": "lavamoat/scripts.yarn.json",
    "build": "lavamoat/scripts.build.json",
    "build:all": "lavamoat/scripts.build.json",
    "build:clean": "lavamoat/scripts.yarn.json",
    "changelog:update": "lavamoat/scripts.lint.json",
    "changelog:validate": "lavamoat/scripts.lint.json",
    "cli": "lavamoat/scripts.cli.json",
    "lint:tsconfigs": "lavamoat/scripts.lint-worker.json",
    "lint:tsconfigs:fix": "lavamoat/scripts.lint-worker.json",
    "messenger-action-types:check": "lavamoat/scripts.lint.json",
    "messenger-action-types:generate": "lavamoat/scripts.lint.json",
    "test": "lavamoat/scripts.test.json",
    "test:clean": "lavamoat/scripts.test.json",
    "test:verbose": "lavamoat/scripts.test.json",
    "test:watch": "lavamoat/scripts.test.json"
  }
}
