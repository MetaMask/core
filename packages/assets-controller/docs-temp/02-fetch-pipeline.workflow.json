        "label": "Chains the fast lane could not serve",
        "focus": ["leftover", "slow_balance", "detect_slow", "enrich_slow"],
        "note": "Errored chains and chains outside Accounts API coverage are retried in the background."
      },
      {
        "id": "ordering",
        "label": "Why graduation precedes fallback",
        "focus": ["fast_balance", "graduation", "rpc_fallback"],
        "note": "Graduation must only ever see Accounts API and websocket balances, never RPC ones."
