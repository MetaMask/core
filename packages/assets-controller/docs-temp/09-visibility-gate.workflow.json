      },
      {
        "id": "hidden",
        "label": "The gate the user controls",
        "focus": ["not_hidden", "withheld"],
        "note": "hideAsset only sets a preference, so the balance keeps refreshing while the row is gone."
      },
      {
        "id": "scope",
        "label": "Scope, not spam",
        "focus": ["chain_ok", "withheld", "visible"],
