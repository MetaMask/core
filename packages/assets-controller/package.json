{
  "name": "@metamask/assets-controller",
  "version": "20.0.1",
  "description": "Tracks assets balances/prices and handles token detection across all digital assets",
  "keywords": [
    "Ethereum",
    "MetaMask"
  ],
  "homepage": "https://github.com/MetaMask/core/tree/main/packages/assets-controller#readme",
  "bugs": {
    "url": "https://github.com/MetaMask/core/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/core.git"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "build:all": "tsc --build tsconfig.build.json --verbose",
    "build:clean": "yarn build:only-clean && yarn build",
    "build:docs": "typedoc",
    "build:only-clean": "rimraf './dist' './tsconfig.build.tsbuildinfo'",
    "changelog:update": "../../scripts/update-changelog.sh @metamask/assets-controller",
    "changelog:validate": "../../scripts/validate-changelog.sh @metamask/assets-controller",
    "lint:tsconfigs": "node --import ../../scripts/resolver/register.ts ../../scripts/lint-tsconfigs/lint-tsconfigs.ts",
    "lint:tsconfigs:fix": "node --import ../../scripts/resolver/register.ts ../../scripts/lint-tsconfigs/lint-tsconfigs.ts --fix",
    "messenger-action-types:check": "node --import ../../scripts/resolver/register.ts ../../packages/messenger-cli/src/cli.ts --formatter oxfmt --esm --check",
    "messenger-action-types:generate": "node --import ../../scripts/resolver/register.ts ../../packages/messenger-cli/src/cli.ts --formatter oxfmt --esm --generate",
    "since-latest-release": "../../scripts/since-latest-release.sh",
    "test": "vitest",
    "test:clean": "vitest --clearCache",
    "test:integration": "vitest --mode integration",
    "test:unit": "vitest --mode unit",
    "test:verbose": "vitest --reporter=verbose",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@ethereumjs/util": "^9.1.0",
    "@ethersproject/abi": "^5.7.0",
    "@ethersproject/providers": "^5.8.0",
    "@metamask/account-tree-controller": "^11.2.0",
    "@metamask/accounts-controller": "^40.1.0",
    "@metamask/assets-controllers": "^113.0.0",
    "@metamask/base-controller": "^10.1.0",
    "@metamask/client-controller": "^2.0.0",
    "@metamask/config-registry-controller": "^5.0.0",
    "@metamask/controller-utils": "^13.0.0",
    "@metamask/core-backend": "^12.3.0",
    "@metamask/keyring-api": "^24.3.0",
    "@metamask/keyring-controller": "^28.2.0",
    "@metamask/keyring-internal-api": "^12.1.2",
    "@metamask/keyring-snap-client": "^10.0.1",
    "@metamask/messenger": "^3.0.0",
    "@metamask/multichain-transactions-controller": "^8.0.0",
    "@metamask/network-controller": "^37.1.1",
    "@metamask/network-enablement-controller": "^7.0.2",
    "@metamask/permission-controller": "^14.1.0",
    "@metamask/phishing-controller": "^18.2.1",
    "@metamask/polling-controller": "^17.0.0",
    "@metamask/preferences-controller": "^24.0.0",
    "@metamask/remote-feature-flag-controller": "^7.0.0",
    "@metamask/snaps-controllers": "^19.0.1",
    "@metamask/snaps-utils": "^12.1.2",
    "@metamask/transaction-controller": "^72.3.0",
    "@metamask/utils": "^12.0.1",
    "async-mutex": "^0.5.0",
    "bignumber.js": "^9.1.2",
    "lodash-es": "^4.18.1"
  },
  "devDependencies": {
    "@metamask/auto-changelog": "^6.2.1",
    "@metamask/eth-json-rpc-provider": "^7.0.0",
    "@types/lodash-es": "^4.17.12",
    "@typescript/native": "npm:typescript@^7.0.2",
    "nock": "^13.5.6",
    "rimraf": "^6.1.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-missing-exports": "^4.1.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.14.0 || ^24 || ^26"
  }
}
