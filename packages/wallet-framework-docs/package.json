{
  "name": "@metamask/wallet-framework-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation for the Wallet Framework",
  "keywords": [
    "Ethereum",
    "MetaMask"
  ],
  "homepage": "https://github.com/MetaMask/core/tree/main/packages/wallet-framework-docs#readme",
  "bugs": {
    "url": "https://github.com/MetaMask/core/issues"
  },
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/core.git"
  },
  "files": [
    "dist/"
  ],
  "sideEffects": false,
  "scripts": {
    "audit-script": "node ../../scripts/audit-script.ts",
    "build": "docusaurus build site",
    "changelog:update": "../../scripts/update-changelog.sh @metamask/wallet-framework-docs",
    "changelog:validate": "../../scripts/validate-changelog.sh @metamask/wallet-framework-docs",
    "dev": "docusaurus start site",
    "lint:tsconfigs": "node --import ../../scripts/resolver/register.ts ../../scripts/lint-tsconfigs/lint-tsconfigs.ts",
    "lint:tsconfigs:fix": "node --import ../../scripts/resolver/register.ts ../../scripts/lint-tsconfigs/lint-tsconfigs.ts --fix",
    "messenger-action-types:check": "node --import ../../scripts/resolver/register.ts ../../packages/messenger-cli/src/cli.ts content --formatter oxfmt --esm --check",
    "messenger-action-types:generate": "node --import ../../scripts/resolver/register.ts ../../packages/messenger-cli/src/cli.ts content --formatter oxfmt --esm --generate",
    "since-latest-release": "../../scripts/since-latest-release.sh",
    "start": "docusaurus serve site",
    "test": "vitest",
    "test:clean": "vitest --clearCache",
    "test:verbose": "vitest --reporter=verbose",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@metamask/base-data-service": "^2.1.0",
    "@metamask/controller-utils": "^13.0.0",
    "@metamask/messenger": "^3.0.0",
    "@metamask/superstruct": "^3.4.1",
    "@metamask/utils": "^12.0.0",
    "@tanstack/query-core": "^5.103.2"
  },
  "devDependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/plugin-content-docs": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-common": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@mdx-js/react": "^3.1.1",
    "@metamask/auto-changelog": "^6.2.1",
    "@types/react": "^19.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "nock": "^13.5.6",
    "prism-react-renderer": "^2.4.1",
    "raw-loader": "^4.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.14.0 || ^24 || ^26"
  },
  "scriptsConfig": {
    "#default": "lavamoat/scripts.strict.json",
    "audit-script": "lavamoat/scripts.yarn.json"
  }
}
