{
  "name": "@metamask/transaction-pay-middleware",
  "version": "2.0.1",
  "description": "Implements the wallet_pay JSON-RPC method, which lets dapps request MetaMask Pay transactions",
  "keywords": [
    "Ethereum",
    "MetaMask"
  ],
  "homepage": "https://github.com/MetaMask/core/tree/main/packages/transaction-pay-middleware#readme",
  "bugs": {
    "url": "https://github.com/MetaMask/core/issues"
  },
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/core.git"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "build:all": "tsc --build tsconfig.build.json --verbose",
    "build:clean": "yarn build:only-clean && yarn build",
    "build:docs": "typedoc",
    "build:only-clean": "rimraf './dist' './tsconfig.build.tsbuildinfo'",
    "changelog:update": "../../scripts/update-changelog.sh @metamask/transaction-pay-middleware",
    "changelog:validate": "../../scripts/validate-changelog.sh @metamask/transaction-pay-middleware",
    "lint:tsconfigs": "node --import ../../scripts/resolver/register.ts ../../scripts/lint-tsconfigs/lint-tsconfigs.ts",
    "lint:tsconfigs:fix": "node --import ../../scripts/resolver/register.ts ../../scripts/lint-tsconfigs/lint-tsconfigs.ts --fix",
    "messenger-action-types:check": "node --import ../../scripts/resolver/register.ts ../../packages/messenger-cli/src/cli.ts --formatter oxfmt --check",
    "messenger-action-types:generate": "node --import ../../scripts/resolver/register.ts ../../packages/messenger-cli/src/cli.ts --formatter oxfmt --generate",
    "since-latest-release": "../../scripts/since-latest-release.sh",
    "test": "vitest",
    "test:clean": "vitest --clearCache",
    "test:verbose": "vitest --reporter=verbose",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@metamask/account-tree-controller": "^11.2.0",
    "@metamask/accounts-controller": "^40.1.0",
    "@metamask/controller-utils": "^13.0.0",
    "@metamask/messenger": "^3.0.0",
    "@metamask/network-controller": "^37.1.1",
    "@metamask/perps-controller": "^22.1.0",
    "@metamask/remote-feature-flag-controller": "^7.0.0",
    "@metamask/rpc-errors": "^7.0.3",
    "@metamask/superstruct": "^3.4.1",
    "@metamask/transaction-controller": "^73.0.0",
    "@metamask/utils": "^12.0.1",
    "bignumber.js": "^9.3.1"
  },
  "devDependencies": {
    "@metamask/auto-changelog": "^6.2.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "rimraf": "^6.1.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-missing-exports": "^4.1.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.14.0 || ^24 || ^26"
  }
}
