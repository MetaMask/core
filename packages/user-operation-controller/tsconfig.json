{
  "extends": "../../tsconfig.packages.json",
  "compilerOptions": {
    /**
     * This package's tests run under Vitest, which does not enable globals,
     * so the repo-wide `types: ["jest"]` in `tsconfig.base.json` must not
     * apply here. This override can go away once every package has moved to
     * Vitest and that line is removed.
     */
    "types": []
  },
  "references": [
    {
      "path": "../base-controller"
    },
    {
      "path": "../controller-utils"
    },
    {
      "path": "../gas-fee-controller"
    },
    {
      "path": "../keyring-controller"
    },
    {
      "path": "../network-controller"
    },
    {
      "path": "../polling-controller"
    },
    {
      "path": "../transaction-controller"
    },
    {
      "path": "../messenger"
    },
    {
      "path": "../approval-controller"
    },
    {
      "path": "../eth-block-tracker"
    },
    {
      "path": "../utils"
    }
  ],
  "include": ["../../types", "./src"]
}
