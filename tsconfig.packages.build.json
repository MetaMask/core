{
  /**
   * This configuration is extended by the `tsconfig.build.json` configuration in each package.
   */
  "extends": "./tsconfig.packages.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "exclude": [
    "./jest.config.packages.ts",
    "**/*.test.ts",
    "**/*.test-d.ts",
    "**/jest.config.ts",
    "**/*.tst.ts"
  ]
}
